{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "adm.srdogao.com.br"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "entregador.srdogao.com.br"
        }
      ],
      "destination": "/entregador/index.html"
    },
    {
      "source": "/",
      "destination": "/cardapio-web-preview/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
