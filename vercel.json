{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "adm.srdogao.com.br"
        }
      ],
      "dest": "/admin/index.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "entregador.srdogao.com.br"
        }
      ],
      "dest": "/entregador/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
